# Backend settings. Use hosted PostgreSQL in production; SQLite is local only.
DATABASE_URL=

# Supabase project settings used by the backend to validate user sessions.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional cross-origin allowlist for a separately hosted frontend/API.
# Same-origin Vercel hosting does not require CORS.
CORS_ALLOWED_ORIGINS=

# Frontend settings (Vite/React). Set these in Vercel for production, or in
# frontend/.env.local for local development.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Set to the stable production frontend origin for password-reset email links.
VITE_APP_ORIGIN=https://YOUR_PRODUCTION_DOMAIN

# Same-origin Vercel API path; local Vite defaults to http://localhost:8000.
VITE_API_BASE_URL=/api
