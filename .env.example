# Backend-only settings. Keep secrets out of VITE_* variables.
# Use the PostgreSQL connection string supplied by your database provider
# for hosted production persistence; local development can leave this empty.
DATABASE_URL=

# Supabase project settings used by the backend to validate user sessions.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated exact HTTPS frontend origins when the frontend is hosted
# separately. Same-origin Vercel services do not need a CORS allowlist.
CORS_ALLOWED_ORIGINS=

# Frontend settings (Vite/React). For local development, put these in
# frontend/.env.local; Vercel reads them from the frontend service's environment.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Leave empty for the same-origin Vercel deployment (/api).
# Locally, frontend/.env.example sets this to http://localhost:8000.
VITE_API_BASE_URL=
