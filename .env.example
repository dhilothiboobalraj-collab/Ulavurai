# Leave unset to use the local SQLite database at predictions.db.
# For hosted production persistence, use the PostgreSQL connection string
# supplied by Neon, Supabase, or another PostgreSQL provider.
DATABASE_URL=

# Comma-separated exact frontend origins. Local origins are allowed automatically
# outside Vercel; set this to the deployed frontend origin for a separate frontend.
CORS_ORIGINS=

# Local Vite development defaults to http://localhost:8000.
# For the combined Vercel deployment, leave empty to use the same-origin /api routes.
VITE_API_URL=
