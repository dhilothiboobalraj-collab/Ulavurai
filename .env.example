# Backend settings. Use a hosted PostgreSQL connection string in Vercel;
# SQLite is for local development only.
DATABASE_URL=

# Supabase project settings used by the backend to validate user sessions.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# The frontend and API share the Vercel origin, so no CORS allowlist is needed.
CORS_ALLOWED_ORIGINS=

# Frontend settings (Vite/React). For local development, put these in
# frontend/.env.local; add them to Vercel's environment for deployment.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Leave empty for the same-origin Vercel API (/api).
# Locally, frontend/.env.example sets this to http://localhost:8000.
VITE_API_BASE_URL=
