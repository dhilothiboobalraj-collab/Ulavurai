# Backend-only settings. Keep secrets out of VITE_* variables.
# Use the PostgreSQL connection string supplied by your database provider
# for hosted production persistence; local development can leave this empty.
DATABASE_URL=

# Supabase project settings used by the backend to validate user sessions.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# Set to the exact HTTPS frontend origin when the frontend and backend use
# different hosts, for example the Vercel site URL.
CORS_ALLOWED_ORIGINS=

# Frontend settings (Vite/React). For local development, put these in
# frontend/.env.local; set these in Vercel's frontend environment for deployment.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Set this to the Render backend's HTTPS origin for production.
# Locally, frontend/.env.example sets it to http://localhost:8000.
VITE_API_BASE_URL=https://YOUR_RENDER_SERVICE.onrender.com
