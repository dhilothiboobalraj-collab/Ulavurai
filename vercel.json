{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{models/**,datasets/**,backend/data/**,frontend/dist/**}"
    }
  }
}